Button.menu_item {
    width: 300px;
    height: 80px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 12px;
    margin-left: 0;
    font-size: 32px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-overflow: ellipsis;
    white-space: nowrap;
    background-color: rgba(255, 255, 255, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    color: rgb(255, 255, 255);
    -unity-font-definition: resource('Fonts/PressStart2P-Regular');
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    transition-property: scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-cubic;
}

Button.menu_item:focus {
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-left-color: rgb(229, 215, 42);
    border-right-color: rgb(229, 215, 42);
    border-top-color: rgb(229, 215, 42);
    border-bottom-color: rgb(229, 215, 42);
    transition-property: scale;
    scale: 1.1 1.1;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-cubic;
    -unity-font-definition: resource('Fonts/PressStart2P-Regular');
}

Button.menu_item:hover {
    border-left-color: rgb(188, 188, 188);
    border-right-color: rgb(188, 188, 188);
    border-top-color: rgb(188, 188, 188);
    border-bottom-color: rgb(188, 188, 188);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    -unity-font-definition: resource('Fonts/PressStart2P-Regular');
}

.ui-screen {
    flex-grow: 1;
    display: none;
}
